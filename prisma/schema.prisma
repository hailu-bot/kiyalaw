generator client {
  provider        = "prisma-client-js"
  binaryTargets   = ["native"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Client {
  id                  String           @id @default(cuid())
  userId              String
  name                String
  contactName         String?
  contactTitle        String?
  email               String?
  phone               String?
  industry            String?
  status              ClientStatus     @default(Active)
  notes               String?
  avatarUrl           String?
  registrationNumber  String?
  taxId               String?
  vatNumber           String?
  businessType        BusinessType?
  dateOfIncorporation DateTime?
  jurisdiction        String?
  registeredAddress   Json?
  billingAddress      Json?
  website             String?
  annualRevenueRange  String?
  employeeCount       Int?
  billingTerms        BillingTerms?
  creditLimit         Decimal?         @db.Decimal(12, 2)
  referralSource      String?
  tags                String[]           @default([])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  matters             Matter[]
  clientDocuments     ClientDocument[]
  rateCards           RateCard[]
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Matter {
  id                  String       @id @default(cuid())
  userId              String
  matterCode          String       @unique
  title               String
  clientName          String
  practiceArea        String
  status              MatterStatus @default(Active)
  billableTargetHours Int?
  leadAttorneyName    String?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  description         String?
  clientId            String?
  billingCycleDays    Int?
  lastBillingDate     DateTime?
  activities          Activity[]
  documents           Document[]
  invoices            Invoice[]
  client              Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  timeEntries         TimeEntry[]
  expenses            Expense[]
  rateCards           RateCard[]
  user                User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, status])
}

model RateCard {
  id            String   @id @default(cuid())
  userId        String
  clientId      String?
  matterId      String?
  rate          Decimal  @db.Decimal(10, 2)
  label         String?
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  client        Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  matter        Matter?  @relation(fields: [matterId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([clientId])
  @@index([matterId])
}

model Invoice {
  id                String            @id @default(cuid())
  userId            String
  invoiceNumber     String
  matterId          String
  clientName        String
  amount            Decimal           @db.Decimal(12, 2)
  dueDateLabel      String
  status            InvoiceStatus     @default(Draft)
  autoGenerated     Boolean           @default(false)
  billingPeriodStart DateTime?
  billingPeriodEnd  DateTime?
  createdAt         DateTime          @default(now())
  approvedAt        DateTime?
  notes             String?
  matter            Matter            @relation(fields: [matterId], references: [id], onDelete: Cascade)
  invoiceApprovals  InvoiceApproval[]
  lineItems         InvoiceLineItem[]
  timeEntries       TimeEntry[]
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([invoiceNumber, matterId])
  @@index([matterId])
  @@index([status])
  @@index([userId])
}

model InvoiceLineItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  hours       Decimal @db.Decimal(8, 2)
  rate        Decimal @db.Decimal(10, 2)
  total       Decimal @db.Decimal(12, 2)
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model TimeEntry {
  id           String   @id @default(cuid())
  userId       String
  matterId     String
  description  String
  date         DateTime
  hours        Decimal  @db.Decimal(6, 2)
  rate         Decimal  @db.Decimal(10, 2)
  billable     Boolean  @default(true)
  category     String?
  attorneyName String?
  notes        String?
  invoiceId    String?
  billedAt     DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  matter       Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)
  invoice      Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([date])
  @@index([userId])
  @@index([invoiceId])
  @@index([matterId, date])
  @@index([userId, date])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Activity {
  id          String       @id @default(cuid())
  userId      String
  matterId    String
  type        ActivityType
  description String
  createdAt   DateTime     @default(now())
  matter      Matter       @relation(fields: [matterId], references: [id], onDelete: Cascade)
  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([userId])
}

model ImageAsset {
  id         String    @id @default(cuid())
  url        String
  uploadedAt DateTime  @default(now())
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model InvoiceApproval {
  id           String   @id @default(cuid())
  invoiceId    String
  approverName String
  decision     String
  note         String?
  createdAt    DateTime @default(now())
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model DocumentFolder {
  id        String           @id @default(cuid())
  name      String
  authorId  String
  parentId  String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  documents Document[]
  parent    DocumentFolder?  @relation("FolderChildren", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderChildren")
  author    User             @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([parentId])
  @@index([authorId])
}

model User {
  id              String            @id @default(cuid())
  email           String            @unique
  name            String?
  avatarUrl       String?
  createdAt       DateTime          @default(now())
  role            Role              @default(ASSOCIATE)
  documents       Document[]
  versions        DocumentVersion[]
  clients         Client[]
  matters         Matter[]
  invoices        Invoice[]
  timeEntries     TimeEntry[]
  activities      Activity[]
  expense         Expense[]
  rateCards       RateCard[]
  documentFolders DocumentFolder[]
}

model Document {
  id            String            @id @default(cuid())
  title         String
  matterId      String?
  authorId      String
  status        DocStatus         @default(Draft)
  headVersionId String?           @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  folderId      String?
  author        User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  folder        DocumentFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  headVersion   DocumentVersion?  @relation("HeadVersion", fields: [headVersionId], references: [id], onDelete: SetNull)
  matter        Matter?           @relation(fields: [matterId], references: [id], onDelete: Cascade)
  shares        DocumentShare[]
  versions      DocumentVersion[]
  images        ImageAsset[]

  @@index([folderId])
}

model DocumentVersion {
  id            String    @id @default(cuid())
  documentId    String
  authorId      String
  body          Json
  bodyText      String?
  versionNumber Int
  changeNote    String?
  createdAt     DateTime  @default(now())
  headFor       Document? @relation("HeadVersion")
  author        User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  document      Document  @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, versionNumber])
  @@index([documentId])
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  body        Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model DocumentShare {
  id          String   @id @default(cuid())
  documentId  String
  token       String   @unique
  permissions String
  expiresAt   DateTime
  createdAt   DateTime @default(now())
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model ClientDocument {
  id           String         @id @default(cuid())
  clientId     String
  fileName     String
  originalName String
  mimeType     String
  fileSize     Int
  label        DocumentLabel
  fileUrl      String
  metadata     Json?
  uploadedAt   DateTime       @default(now())
  client       Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  matterId    String?
  description String
  amount      Decimal  @db.Decimal(12, 2)
  category    String   @default("Other")
  date        DateTime
  billable    Boolean  @default(true)
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  matter      Matter?  @relation(fields: [matterId], references: [id], onDelete: SetNull)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([matterId])
  @@index([userId])
  @@index([date])
}

model FirmProfile {
  id                  String   @id @default("default")
  firmName            String   @default("Kiya Law")
  defaultRate         Int      @default(350)
  logoUrl             String?
  address             String?
  phone               String?
  email               String?
  website             String?
  timezone            String   @default("America/New_York")
  dateFormat          String   @default("MM/DD/YYYY")
  emailNotifications  Boolean  @default(true)
  billingAlerts       Boolean  @default(true)
  automationSettings  Json?
  billingCycleDays    Int      @default(30)
  billingLeadDays     Int      @default(5)
  lastBillingRun      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

enum DocumentLabel {
  CertificateOfIncorporation
  TaxDocument
  BusinessLicense
  Identification
  Contract
  CourtFiling
  FinancialStatement
  InsuranceCertificate
  ComplianceDocument
  Other
}

enum BusinessType {
  LLC
  Corporation
  Partnership
  SoleProprietorship
  NonProfit
  Other
}

enum BillingTerms {
  Net15
  Net30
  Net45
  Net60
  Net90
  DueOnReceipt
}

enum ClientStatus {
  Active
  Inactive
  Prospect
}

enum MatterStatus {
  Active
  Pending
  Closed
}

enum ActivityType {
  time
  document
  communication
}

enum InvoiceStatus {
  Draft
  PendingApproval
  Approved
  Finalized
  Paid
}

enum DocStatus {
  Draft
  InReview
  Finalized
  Archived
}

enum Role {
  PARTNER
  ASSOCIATE
  PARALEGAL
  CLIENT
}
