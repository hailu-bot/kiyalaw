# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Testing
/coverage

# Next.js Build and Export Outputs
/.next/
/out/

# Electron Build Artifacts & Windows Installers
dist/
release/
*.exe
*.dmg
*.AppImage

# Production Builds
/build

# Environment Secrets (Crucial for Security)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Vercel Deployment Metadata
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Miscellaneous & System Files
.DS_Store
Thumbs.db
*.pem

# Logs and Debugging
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*